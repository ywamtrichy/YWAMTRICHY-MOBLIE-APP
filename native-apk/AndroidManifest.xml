<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.ywamtrichy.beneficiary"
    android:versionCode="11"
    android:versionName="1.1.0">

    <uses-sdk android:minSdkVersion="23" android:targetSdkVersion="33" />

    <!-- Only network access is needed. The camera app is started through a normal
         "take photo" request, so the app does not need the CAMERA permission itself. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/AppTheme"
        android:allowBackup="false"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".MainActivity"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|screenLayout|uiMode|navigation|locale|layoutDirection|fontScale"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Hands the camera app one private file to write the photo into. -->
        <provider
            android:name=".CameraProvider"
            android:authorities="org.ywamtrichy.beneficiary.camera"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
